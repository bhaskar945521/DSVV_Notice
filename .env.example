# Environment Variables — DSVV Notice Aggregator

# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/dsvv_notices

# Auth
JWT_SECRET=dsvv_super_secret_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# AI Provider (demo | openai | gemini)
# Set to 'gemini' to use Google Gemini API
AI_PROVIDER=gemini

# Google Gemini API Key — get one free at https://aistudio.google.com/app/apikey
AI_API_KEY=your_gemini_api_key_here

# Gemini model name (default: gemini-1.5-flash — fast & free tier friendly)
AI_MODEL=gemini-1.5-flash

# Storage (local | s3 | cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads/
MAX_FILE_SIZE_MB=10

# Web Push (optional)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_EMAIL=admin@dsvv.ac.in

# Email (optional — architecture only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@dsvv.ac.in
